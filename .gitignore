# ============================================================
# Enterprise Data Integration Platform — .gitignore
# ============================================================

# ─── SECRETS & CREDENTIALS ───────────────────────────────────
# Never commit these — rotate immediately if accidentally pushed
.env
.env.*
*.env
!.env.example
application-prod.yml
application-dev.yml
application-local.yml
secrets.yml
credentials.json
*.pem
*.key
*.p12
*.jks
*.keystore

# ─── JAVA / MAVEN ────────────────────────────────────────────
# Build output — regenerated by `mvn clean install`
backend/target/

# Maven wrapper (optional — keep if you want reproducible builds)
# !backend/.mvn/wrapper/maven-wrapper.jar

# IDE-generated Maven files
backend/.classpath
backend/.project
backend/.settings/

# ─── SPRING BOOT ─────────────────────────────────────────────
# Log files generated at runtime
*.log
logs/
backend/logs/

# ─── FRONTEND (Node / React / Vite) ──────────────────────────
# Dependencies — restored by `npm install`
frontend/node_modules/

# Vite / React build output
frontend/dist/
frontend/build/
frontend/.vite/

# Local env files (Vite uses these for secrets)
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ─── IDEs & EDITORS ──────────────────────────────────────────
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# Eclipse
.classpath
.project
.settings/
bin/

# NetBeans
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# ─── OPERATING SYSTEM ────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ─── MISC ────────────────────────────────────────────────────
# Compiled class files
*.class

# Package files
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Test coverage reports
coverage/
*.lcov
htmlcov/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
